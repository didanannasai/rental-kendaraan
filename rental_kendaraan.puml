@startuml

entity Penyewaan {
    *id_penyewaan : integer(10) <<PK>>
    --
    *id_pelanggan : integer(10) <<FK>>
    *id_kendaraan : integer(10) <<FK>>
    --
    *tanggal_pesan : date
    *tanggal_mulai_sewa : date
    *tanggal_akhir_sewa : date
    *tanggal_pengembalian : date
    *total_biaya : integer(10)
    *kondisi_kendaraan_sebelum : varchar(255)
    *kondisi_kendarran_sesudah : varchar(255)
    *status_pengembalian : varchar(255)
}

entity Pelanggan {
    *id_pelanggan : integer(10) <<PK>>
    --
    *nik : integer(10)
    *nama : varchar(255)
    *tanggal_lahir : date
    *jenis_kelamin : varchar(255)
    *alamat : varchar(255)
    *no_hp : integer(10)
    *email : varchar(255)
    *status_anggota : boolean
    *total_penyewaan : integer(10)
}

entity Pembayaran {
    *id_pembayaran : integer(10) <<PK>>
    --
    *id_penyewaan : integer(10) <<FK>>
    --
    *tanggal_bayar : date
    *metode_bayar : varchar(255)
    *status_bayar : boolean
}

entity Denda {
    *id_denda : integer(10) <<PK>>
    --
    *id_penyewaan : integer(10) <<FK>>
    --
    *jumlah_denda : integer(10)
    *alasan : varchar(255)
    *status_denda : boolean
}

entity Pegawai {
    *id_pegawai : integer(10) <<PK>>
    --
    *nik : integer(10)
    *nama_lengkap : varchar(255)
    *alamat : varchar(255)
    *no_hp : integer(10)
    *email : varchar(255)
    *tanggal_lahir : date
    *jenis_kelamin : varchar(255)
    *jabatan : varchar(255)
}

entity Kendaraan {
    *id_kendaraan : integer(10) <<PK>>
    --
    *id_cabang : integer(10) <<FK>>
    --
    *plat_nomor : integer(10)
    *merek : varchar(255)
    *model : varchar(255)
    *tipe : varchar(255)
    *tahun_pembuatan : year
    *warna : varchar(255)
    *kapasitas_penumpang : integer(10)
    *jenis_kendaraan : varchar(255)
    *transmisi : varchar(255)
    *bahan_bakar : varchar(255)
    *harga_sewa : integer(10)
    *status_kendaraan : boolean
}

entity Cabang {
    *id_cabang : integer(10) <<PK>>
    --
    *nama_cabang : varchar(255)
    *alamat : varchar(255)
    *no_hp : integer(10)
}

entity tracking_GPS {
    *id_tracking : integer(10) <<PK>>
    --
    *id_kendaraan : integer(10) <<FK>>
    --
    *waktu : time
    *latitude : integer(10)
    *longtitude : integer(10)
}

Penyewaan}|--o|Pelanggan
note on link
    Melakukan
end note
Penyewaan||--||Pembayaran
note on link
    Melakukan
end note
Penyewaan|o--o{Denda
note on link
    Mendapat
end note
Penyewaan||--|{Kendaraan
note on link
    Disewa
end note
Penyewaan}|--||Pegawai
note on link
    Mengelola
end note

Kendaraan}|--||Cabang
note on link
    Mempunyai
end note
Kendaraan|o--|{tracking_GPS
note on link
    Mempunyai
end note

Pegawai}|--||Cabang
note on link
    Mempunyai
end note


@enduml